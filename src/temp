<div
          style={{
            display: "grid",
            gridTemplateColumns: "160px 1fr 220px",
            gridTemplateRows: "auto auto auto",
            gap: "1px",
            background: "#222",
            border: "1px solid #222",
            marginTop: "1px",
          }}
        >
          {/* ── NAV (left col, rows 1-2) ── */}
          <div
            style={{
              background: "#0d0d0d",
              padding: "28px 24px",
              gridRow: "1 / 3",
              display: "flex",
              flexDirection: "column",
              justifyContent: "space-between",
              animation: "fadeUp 0.5s ease 0.1s both",
            }}
          >
            <nav>
              {navLinks.map((l) => (
                <div key={l} className="nav-link">
                  {l}
                </div>
              ))}
            </nav>
            <div
              style={{
                marginTop: "32px",
                paddingTop: "20px",
                borderTop: "1px solid #1e1e1e",
              }}
            >
              {["React, WebGL", "WebGL, GSAP", "Next.js"].map((t, i) => (
                <div
                  key={i}
                  style={{
                    fontFamily: "'IBM Plex Mono', monospace",
                    fontSize: "10px",
                    color: "#444",
                    letterSpacing: "0.12em",
                    lineHeight: 1.9,
                    transform: `rotate(-${i % 2 === 0 ? 0 : 0}deg)`,
                  }}
                >
                  {t}
                </div>
              ))}
            </div>
          </div>

          {/* ── RECENT EXPERIMENTS (center top) ── */}
          <div
            style={{
              background: "#0d0d0d",
              padding: "22px 28px",
              animation: "fadeUp 0.5s ease 0.15s both",
            }}
          >
            <div
              style={{
                fontFamily: "'IBM Plex Mono', monospace",
                fontSize: "11px",
                letterSpacing: "0.2em",
                color: "#555",
                marginBottom: "16px",
              }}
            >
              RECENT EXPERIMENTS
            </div>
            <ol style={{ listStyle: "none", paddingLeft: 0 }}>
              {experiments.map((exp, i) => (
                <li
                  key={i}
                  style={{
                    display: "flex",
                    alignItems: "center",
                    gap: "12px",
                    fontFamily: "'IBM Plex Mono', monospace",
                    fontSize: "12px",
                    color: "#999",
                    padding: "5px 0",
                    borderBottom: "1px solid #1a1a1a",
                    cursor: "pointer",
                    transition: "color 0.2s",
                    animation: `fadeUp 0.4s ease ${0.2 + i * 0.08}s both`,
                  }}
                  onMouseEnter={(e) =>
                    (e.currentTarget.style.color = "#b8f5a0")
                  }
                  onMouseLeave={(e) => (e.currentTarget.style.color = "#999")}
                >
                  <span style={{ color: "#333", minWidth: "18px" }}>
                    0{i + 1}.
                  </span>
                  {exp}
                </li>
              ))}
            </ol>
          </div>

          {/* ── SIDE QUOTE (right col, row 1) ── */}
          <div
            style={{
              background: "#0d0d0d",
              padding: "22px 20px",
              borderLeft: "1px solid #1a1a1a",
              gridRow: "1 / 3",
              display: "flex",
              flexDirection: "column",
              justifyContent: "center",
              animation: "fadeUp 0.5s ease 0.2s both",
            }}
          >
            <div
              style={{
                writingMode: "vertical-rl",
                textOrientation: "mixed",
                transform: "rotate(180deg)",
                fontFamily: "'Bebas Neue', sans-serif",
                fontSize: "13px",
                letterSpacing: "0.22em",
                color: "#666",
                lineHeight: 1.4,
              }}
            >
              CRAFTING INTERACTIVE WORLDS.
            </div>
            <div
              style={{
                marginTop: "24px",
                fontFamily: "'DM Sans', sans-serif",
                fontSize: "11px",
                color: "#444",
                lineHeight: 1.7,
              }}
            >
              The intersection of logic and beauty is a place where I create
              experiences that resonate.
            </div>
            <div style={{ marginTop: "24px" }}>
              <div
                className="corner-spin"
                style={{
                  width: "28px",
                  height: "28px",
                  border: "1px solid #333",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  fontSize: "16px",
                  color: "#b8f5a0",
                }}
              >
                ✦
              </div>
            </div>
          </div>

          {/* ── PROJECTS GRID (center, row 2) ── */}
          <div
            style={{
              background: "#0d0d0d",
              padding: "20px 28px 24px",
              gridColumn: "2 / 3",
            }}
          >
            <div
              style={{
                display: "grid",
                gridTemplateColumns: "repeat(3, 1fr)",
                gap: "12px",
              }}
            >
              {projects.map((p, i) => (
                <ProjectCard key={p.id} project={p} index={i} />
              ))}
            </div>
          </div>

          {/* ── CHRONICLE (left-center, row 3) ── */}
          <div
            style={{
              background: "#0d0d0d",
              padding: "22px 28px",
              gridColumn: "1 / 3",
              borderTop: "1px solid #1a1a1a",
              animation: "fadeUp 0.5s ease 0.4s both",
            }}
          >
            <div
              style={{
                display: "flex",
                alignItems: "flex-start",
                gap: "8px",
                marginBottom: "10px",
              }}
            >
              <span
                style={{
                  fontFamily: "'Bebas Neue', sans-serif",
                  fontSize: "48px",
                  color: "#e0e0e0",
                  lineHeight: 0.9,
                  marginRight: "2px",
                }}
              >
                C
              </span>
              <span
                style={{
                  fontFamily: "'Bebas Neue', sans-serif",
                  fontSize: "22px",
                  letterSpacing: "0.18em",
                  color: "#e0e0e0",
                  marginTop: "6px",
                }}
              >
                HRONICLE
              </span>
            </div>
            <p
              style={{
                fontFamily: "'DM Sans', sans-serif",
                fontSize: "12px",
                color: "#555",
                lineHeight: 1.7,
                maxWidth: "520px",
              }}
            >
              An upcoming collection bridging the Millarty framework with live
              generative systems — launching with root compatibility for
              reactive band projects and emerging creative formats.
            </p>
            <div
              style={{
                marginTop: "14px",
                height: "2px",
                background: "#1a1a1a",
                overflow: "hidden",
              }}
            >
              <div
                style={{
                  height: "100%",
                  background: "#b8f5a0",
                  animation: "slideRight 2s ease 1s both",
                }}
              />
            </div>
          </div>

          {/* ── CONTACT FORM (right, row 3) ── */}
          <div
            style={{
              background: "#0d0d0d",
              padding: "22px 20px",
              borderTop: "1px solid #1a1a1a",
              animation: "fadeUp 0.5s ease 0.45s both",
            }}
          >
            <div
              style={{
                fontFamily: "'IBM Plex Mono', monospace",
                fontSize: "9px",
                letterSpacing: "0.2em",
                color: "#444",
                marginBottom: "14px",
              }}
            >
              GET IN TOUCH
            </div>
            <div
              style={{ display: "flex", flexDirection: "column", gap: "10px" }}
            >
              <div>
                <label
                  style={{
                    fontSize: "9px",
                    fontFamily: "'IBM Plex Mono', monospace",
                    color: "#444",
                    letterSpacing: "0.1em",
                  }}
                >
                  Name
                </label>
                <input
                  placeholder="your name"
                  value={formData.name}
                  onChange={(e) =>
                    setFormData({ ...formData, name: e.target.value })
                  }
                />
              </div>
              <div
                style={{
                  display: "grid",
                  gridTemplateColumns: "1fr 1fr",
                  gap: "12px",
                }}
              >
                <div>
                  <label
                    style={{
                      fontSize: "9px",
                      fontFamily: "'IBM Plex Mono', monospace",
                      color: "#444",
                      letterSpacing: "0.1em",
                    }}
                  >
                    Email
                  </label>
                  <input
                    placeholder="you@mail.com"
                    value={formData.email}
                    onChange={(e) =>
                      setFormData({ ...formData, email: e.target.value })
                    }
                  />
                </div>
                <div>
                  <label
                    style={{
                      fontSize: "9px",
                      fontFamily: "'IBM Plex Mono', monospace",
                      color: "#444",
                      letterSpacing: "0.1em",
                    }}
                  >
                    Mobile
                  </label>
                  <input
                    placeholder="+1 000"
                    value={formData.mobile}
                    onChange={(e) =>
                      setFormData({ ...formData, mobile: e.target.value })
                    }
                  />
                </div>
              </div>
              <div>
                <label
                  style={{
                    fontSize: "9px",
                    fontFamily: "'IBM Plex Mono', monospace",
                    color: "#444",
                    letterSpacing: "0.1em",
                  }}
                >
                  Info
                </label>
                <input
                  placeholder="brief context"
                  value={formData.info}
                  onChange={(e) =>
                    setFormData({ ...formData, info: e.target.value })
                  }
                />
              </div>
              <div>
                <label
                  style={{
                    fontSize: "9px",
                    fontFamily: "'IBM Plex Mono', monospace",
                    color: "#444",
                    letterSpacing: "0.1em",
                  }}
                >
                  Subject
                </label>
                <input
                  placeholder="project / collab / hello"
                  value={formData.subject}
                  onChange={(e) =>
                    setFormData({ ...formData, subject: e.target.value })
                  }
                />
              </div>
              <button className="send-btn" onClick={handleSend}>
                {sent ? "✓ SENT" : "SEND"}
              </button>
            </div>
          </div>
        </div>